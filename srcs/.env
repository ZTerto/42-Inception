# 🌍 Dominio y puerto HTTPS
# Usados en docker-compose.yml y en la configuración de Nginx (No cambies estos valores)
DOMAIN_NAME=zajodar.42.fr
DOMAIN_PORT=5000
DATA_PATH=/home/ajodar/data

# 🛠️ Base de datos - WordPress
# Usadas en docker-compose.yml y en entrypoint.sh (No cambies estos valores)
MYSQL_DATABASE="wordpress"
MYSQL_USER="wp_user"
MYSQL_PASSWORD="wp_pass"
MYSQL_ROOT_PASSWORD="rootpass"

# ⚙️ Variables WordPress (usadas en entrypoint.sh)
# WordPress Database Configuration (No cambies estos valores)
DB_NAME="wordpress"
DB_USER="wp_user"
DB_PASS="wp_pass"
DB_HOST="mariadb:3306"
WP_PATH="/var/www/wordpress"
WP_URL="https://zajodar.42.fr"
WP_TITLE="ajodar WordPress"

# ⚙️ Fuerza la recreación de los usuarios de WordPress al iniciar el contenedor
FORCE_RECREATE_USERS=false

# 👤 WordPress Users (CMS)
WP_ADMIN="ajodar"
WP_ADMIN_PASS="wpadminpass"
WP_ADMIN_EMAIL="admin@example1.com"

WP_USER="wpuser"
WP_USER_PASS="wpuserpass"
WP_USER_EMAIL="wpuser@example1.com"

