# 🌍 Dominio y puerto HTTPS
DOMAIN_NAME=zajodar.42.fr
DOMAIN_PORT=5000

# 🛢️ Base de datos - MariaDB
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_db_user
MYSQL_PASSWORD=wp_db_pass
MYSQL_ADMIN_USER=site_admin
MYSQL_ADMIN_PASSWORD=adminpass
MYSQL_ROOT_PASSWORD=rootpass

# 🧠 WordPress Config (conexión a DB)
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp_db_user
WORDPRESS_DB_PASSWORD=wp_db_pass

# 👤 WordPress Users (CMS)
WP_TITLE=ZT WordPress
WP_ADMIN=zt_admin
WP_ADMIN_PASSWORD=wpadminpass
WP_ADMIN_EMAIL=admin@example.com

WP_USER=wp_author
WP_PASSWORD=wpauthorpass
WP_USER_EMAIL=author@example.com
