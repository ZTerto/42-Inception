# 🌍 Ports and domains
# Used in docker-compose.yml and nginx.conf (Do not change these values for the proyect to work)
DOMAIN_NAME=ajodar.42.fr
DOMAIN_PORT=5000
DATA_PATH=/home/${USER}/data

# 🛠️ DB -> Wordpress
# Usadas en docker-compose.yml y en entrypoint.sh (No cambies estos valores)
MYSQL_DATABASE="wordpress"
MYSQL_USER="wp_user"
MYSQL_PASSWORD="wp_pass"
MYSQL_ROOT_PASSWORD="rootpass"

# ⚙️ WordPress Settings
# WordPress Database Configuration (No cambies estos valores)
DB_NAME="wordpress"
DB_USER="wp_user"
DB_PASS="wp_pass"
DB_HOST="mariadb:3306"
WP_PATH="/var/www/wordpress"
WP_URL="https://ajodar.42.fr"
WP_TITLE="ajodar WordPress"

# ⚙️ Force recreate users
FORCE_RECREATE_USERS=false

# 👤 WordPress Users
WP_ADMIN="ajodar"
WP_ADMIN_PASS="wpadminpass"
WP_ADMIN_EMAIL="admin@example1.com"

WP_USER="wpuser"
WP_USER_PASS="wpuserpass"
WP_USER_EMAIL="wpuser@example1.com"
